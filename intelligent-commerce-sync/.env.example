# Candidate Shopee integration configuration.
# External Shopee protocol details are not yet primary-source verified.
# Live remote transport must remain disabled until legitimate access
# and official integration details are independently verified.
#
# NEVER commit real credentials.
# Fill credential values only in a local untracked .env file when authorized.

SHOPEE_ENVIRONMENT=
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=
SHOPEE_ACCESS_TOKEN=
SHOPEE_REFRESH_TOKEN=

# Default Pricing Policy
PRICING_MARKUP_MODE=percentage
PRICING_MARKUP_VALUE=20
PRICING_ROUNDING_UNIT=1000

# Default Inventory Policy
# Undisclosed source quantity requires review by default.
# Safety stock must be an explicit seller/operator decision.
INVENTORY_UNDISCLOSED_POLICY=needs_review
INVENTORY_SAFETY_STOCK=

# PostgreSQL Database Connection
# Used for Prisma ORM persistence in Phase 4.
# Local runtime configuration placeholder only — NEVER commit actual database credentials or connection strings.
DATABASE_URL=
